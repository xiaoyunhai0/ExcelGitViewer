# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test, type-check, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging and PyInstaller output
build/
dist/
*.egg-info/
/*.spec

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Local logs and temporary files
*.log
*.tmp
*.bak

# Local workbook samples. Versioned synthetic fixtures belong under tests/fixtures/.
/*.xls
/*.xlsx
/*.xlsm
/*.xlsb
~$*.xls*
